[Unit]
Description=BEMine v5 automatic mining operations
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pinkuang-v5-signer
Group=pinkuang-v4-relay
SupplementaryGroups=pinkuang-v4-relay
WorkingDirectory=@RUNTIME@
EnvironmentFile=/etc/pinkuang-v5/rpc.env
EnvironmentFile=/etc/pinkuang-v5/product.env
Environment=FRESH_PURCHASE_ENABLED=1
LoadCredential=keeper-private-key:/etc/pinkuang/keeper.key
ExecStart=/usr/bin/node scripts/mining-supervisor.mjs --factory 0x4A866e14816d8339A530c6c82300DBBb6544b37c --rpc ${DEPLOYMENT_JOURNAL_RPC_URL} --journal-dir /var/lib/pinkuang-v5-signer/mining --fresh-graph --send --interval 30 --authority 0x434b837ADeE65D81923E8dcB329a36b40Aa68fB3 --max-gas-bnb 0.02 --max-gas-price-gwei 1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pinkuang-v5-signer
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
