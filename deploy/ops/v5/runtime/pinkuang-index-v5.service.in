[Unit]
Description=BEMine v5 independent chain index
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pinkuang-v5-product
Group=pinkuang-v5-product
SupplementaryGroups=pinkuang-v4-relay
WorkingDirectory=@RUNTIME@
EnvironmentFile=/etc/pinkuang-v5/rpc.env
EnvironmentFile=/etc/pinkuang-v5/product.env
Environment=CHAIN_INDEX_HOST=127.0.0.1
Environment=CHAIN_INDEX_PORT=4224
Environment=CHAIN_INDEX_DB=/var/lib/pinkuang-index-v5/index.sqlite
Environment=CHAIN_INDEX_MODE=fresh-v4
Environment=CHAIN_INDEX_CONFIRMATIONS=12
Environment=CHAIN_INDEX_SCAN_RANGE=500
Environment=CHAIN_INDEX_HEADER_CONCURRENCY=4
Environment=CHAIN_INDEX_LOGS_TIMEOUT_MS=30000
Environment=CHAIN_INDEX_FRESH_MANIFEST_PATH=@RUNTIME@/public/fresh-product-manifest.json
Environment=CHAIN_INDEX_FRESH_MANIFEST_SHA256=@INDEX_SHA@
ExecStart=/usr/bin/node server/chain-index/server.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pinkuang-index-v5
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
