    assert legacy()==CONFIG['legacy'],'Refresh legacy snapshot; do not override'
    assert sha(regular(site))==CONFIG['nginxSha256'] and sha(regular(unit))==CONFIG['deployUnitSha256']
    assert service('pinkuang-deploy-v2.service')['ActiveState']=='active'
    index_before=service('pinkuang-index-v2.service');assert index_before['ActiveState'] in ['active','inactive']
    if dual_graph:
