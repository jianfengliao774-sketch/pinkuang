def restore(state):
    # Restore only bytes/links still owned by this release; never overwrite concurrent edits.
    for name,path in [('unit',unit),('index-unit',index_unit),('nginx',site),('snippet',snippet),('record',record_path)]:
        no_links(path)
        if path.exists():assert sha(regular(path)) in [state['candidateHashes'][name],state['beforeHashes'].get(name)],'Concurrent edit blocks rollback: '+str(path)
        else:assert name not in state['beforeHashes'],'Original file disappeared: '+str(path)
    assert link_target() in [str(product),state['priorProductLink']],'Concurrent product link change'
    run(['systemctl','stop','pinkuang-deploy-v2.service'],timeout=60)
    if service('pinkuang-index-v2.service').get('LoadState')!='not-found':
        run(['systemctl','stop','pinkuang-index-v2.service'],timeout=60)
    if not state['indexWasEnabled'] and index_unit.exists():run(['systemctl','disable','pinkuang-index-v2.service'])
    for name,path in [('unit',unit),('index-unit',index_unit),('nginx',site),('snippet',snippet),('record',record_path)]:
        no_links(path)
        if path.exists() and sha(path.read_bytes())!=state['candidateHashes'][name]:
            if state['beforeHashes'].get(name)==sha(path.read_bytes()):continue
            raise RuntimeError('Concurrent edit blocks rollback: '+str(path))
        saved=backup/(name+'.before')
        if saved.exists():
            if not path.exists() or path.read_bytes()!=saved.read_bytes() or stat.S_IMODE(path.stat().st_mode)!=state['beforeModes'][name]:
                replace(path,saved.read_bytes(),state['beforeModes'][name])
        elif path.exists():path.unlink()
    if link_target()==str(product):
        if state['priorProductLink'] is None:public_current.unlink()
        else:set_link(state['priorProductLink'])
    elif link_target()!=state['priorProductLink']:raise RuntimeError('Concurrent product link change')
    run(['systemctl','daemon-reload']);run(['systemctl','restart','pinkuang-deploy-v2.service'])
    if state['indexWasActive']:run(['systemctl','restart','pinkuang-index-v2.service'])
    elif service('pinkuang-index-v2.service').get('LoadState')!='not-found':run(['systemctl','stop','pinkuang-index-v2.service'])
    run(['nginx','-t']);run(['systemctl','reload','nginx'])
    assert legacy()==state['legacy'];assert journal.exists(),'Journal must remain untouched'

