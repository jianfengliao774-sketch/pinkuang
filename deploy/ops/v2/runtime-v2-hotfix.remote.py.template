def verified_genesis_graph(body,manifest):
    graph=json.loads(body)
    assert graph.get('status')=='verified' and graph.get('chainId')==56 and graph.get('stage')=='genesis'
    assert graph.get('readMode')=='current' and graph.get('stale') is False and graph.get('operationalReady') is False
    assert graph.get('upgradeArtifactDigest') is None and graph.get('operationId') is None
    digest=manifest['artifactDigest']
    for key in ['artifactDigest','genesisArtifactDigest']:
        assert str(graph.get(key,'')).lower()==digest.lower(),'Wrong original artifact digest'
    for key in ['factory','portfolioFactory']:
        assert str(graph.get(key,'')).lower()==manifest[key].lower(),'Wrong original factory'
    deployment=manifest['deployment']
    assert graph.get('stageActivationBlock')==deployment['blockNumber']
    assert str(graph.get('stageActivationHash','')).lower()==deployment['blockHash'].lower()
    assert type(graph.get('verifiedBlockNumber')) is int and graph['verifiedBlockNumber']>=manifest['verifiedBlockNumber']
    assert re.fullmatch(r'0x[0-9a-fA-F]{64}',str(graph.get('verifiedBlockHash','')))
    published=graph.get('manifest',{})
    assert published.get('schemaVersion')==1 and published.get('chainId')==56 and published.get('kind')=='integrated-v2'
    assert published.get('deployment')==deployment and published.get('verifiedBlockNumber')==deployment['blockNumber']
    assert published.get('sourceCommit')==manifest['sourceCommit']
    assert str(published.get('artifactDigest','')).lower()==digest.lower()
    for key in ['factory','shareMarket','lens','beacon','timelock','portfolioFactory','portfolioMarket','portfolioBeacon','portfolioImplementation','portfolioFactoryImplementation']:
        assert str(published.get(key,'')).lower()==manifest[key].lower(),'Wrong original address: '+key
        assert str(published.get('codehash',{}).get(key,'')).lower()==manifest['codehash'][key].lower(),'Wrong original code: '+key
    return {'stage':'genesis','verifiedBlockNumber':graph['verifiedBlockNumber']}

def current_database_ids(require_idle=False):
    u=pwd.getpwnam('pinkuang-v2')
    for path in [journal,index_db]:
        no_links(path);st=path.stat();parent=path.parent.stat()
        assert st.st_uid==u.pw_uid and st.st_gid==u.pw_gid and stat.S_IMODE(st.st_mode)==0o600
        assert parent.st_uid==u.pw_uid and parent.st_gid==u.pw_gid and stat.S_IMODE(parent.st_mode)==0o700
    s=journal.stat();journal_identity=(s.st_dev,s.st_ino)
    if require_idle:assert journal_ready()==journal_identity
    s=index_db.stat()
    assert s.st_uid==u.pw_uid and s.st_gid==u.pw_gid and stat.S_IMODE(s.st_mode)==0o600
    db=sqlite3.connect('file:'+str(index_db)+'?mode=ro',uri=True);db.execute('PRAGMA query_only=ON')
    try:
        identity=json.loads(db.execute("SELECT value FROM metadata WHERE key='identity'").fetchone()[0]);m=CONFIG['manifest']
        expected={'version':2,'chainId':56,'factory':m['factory'].lower(),'market':m['shareMarket'].lower(),
          'portfolioFactory':m['portfolioFactory'].lower(),'portfolioMarket':m['portfolioMarket'].lower(),'startBlock':m['deployment']['blockNumber']}
        assert identity==expected,'Index DB belongs to a different graph'
    finally:db.close()
    return {'journal':list(journal_identity),'index':[s.st_dev,s.st_ino]}

def preserved_surface(require_legacy_identity=True):
    observed=legacy()
    if require_legacy_identity:assert observed==CONFIG['legacy'],'Legacy services or links changed'
    else:
        # A restart of an unrelated legacy service changes MainPID and
        # InvocationID, but cannot justify leaving the v2 hotfix half-applied.
        assert observed['links']==CONFIG['legacy']['links'],'Legacy links changed'
        for name,expected in CONFIG['legacy']['services'].items():
            actual=observed['services'][name]
            for key in ['LoadState','ActiveState','SubState','User','Group']:
                assert actual.get(key)==expected.get(key),'Legacy service state changed: '+name+'.'+key
    assert sha(regular(site))==CONFIG['nginxSha256'] and sha(regular(record_path))==CONFIG['trustedRecordSha256']
    assert link_target()==str(product),'Product current must remain on the approved release'

def restore_hotfix(state):
    # Preflight every file and DB identity before stopping either service.
    preserved_surface(False);assert current_database_ids()==state['databaseIds']
    for name,path in targets.items():
        assert sha(regular(path)) in [state['beforeHashes'][name],state['candidateHashes'][name]],'Concurrent edit blocks rollback'
    for name in ['pinkuang-deploy-v2.service','pinkuang-index-v2.service']:run(['systemctl','stop',name],timeout=60)
    assert current_database_ids()==state['databaseIds']
    for name,path in targets.items():replace(path,regular(backup/(name+'.before')),state['beforeModes'][name])
    run(['systemctl','daemon-reload'])
    for name in ['pinkuang-deploy-v2.service','pinkuang-index-v2.service']:run(['systemctl','start',name],timeout=60)
    # Even a failed reload command may have applied the candidate. Always reload restored bytes.
    run(['nginx','-t']);run(['systemctl','reload','nginx'])
    preserved_surface(False);assert current_database_ids()==state['databaseIds']

def observe_index_cycles():
    # Record successful complete cycles; an in-progress scan is not a verified snapshot.
    deadline=time.monotonic()+90;successes=0;samples=0;unavailable=0;http503=0;blocks=set()
    while time.monotonic()<deadline:
        samples+=1
        try:
            code,body=public('/bemine-v2/api/chain-index/health')
            if code==503:http503+=1
            if code==200 and verified_index(body,deadline):
                successes+=1;blocks.add(json.loads(body)['source']['indexedThrough'])
            else:unavailable+=1
        except (OSError,ValueError):unavailable+=1
        print(json.dumps({'indexCycleObservation':{'samples':samples,'verifiedSamples':successes,'distinctIndexedBlocks':len(blocks),'incompleteOrUnavailable':unavailable,'http503':http503}}),flush=True)
        if successes>=3 and len(blocks)>=2:return
        time.sleep(max(0,min(10,deadline-time.monotonic())))
    raise RuntimeError('Index did not supply three verified snapshots spanning two completed cycles')

def public_acceptance(runtime_manifest,product_manifest):
    for path,name in [('/','dist/index.html'),('/deployment-artifacts.json','dist/deployment-artifacts.json')]:
        code,body=http('http://127.0.0.1:4174'+path);assert code==200 and sha(body)==runtime_manifest['files'][name]['sha256']
        # The deployment console's public route was retired. Its runtime must
        # still serve the reviewed bytes locally, while both public URLs stay gone.
        code,_=public('/pinkuang-deploy-v2'+path);assert code==410
    for path,name in [('/bemine-v2/','public/bemine-v2/index.html'),('/bemine-v2/data/frontend-manifest.json','public/bemine-v2/data/frontend-manifest.json')]:
        code,body=public(path);assert code==200 and sha(body)==product_manifest['files'][name]['sha256']
    code,body=http('http://127.0.0.1:4174/api/journal/product-graph');assert code==200
    print(json.dumps({'localGenesisGraph':verified_genesis_graph(body,CONFIG['manifest'])}),flush=True)
    code,body=public('/bemine-v2/api/journal/product-graph');assert code==200
    print(json.dumps({'publicGenesisGraph':verified_genesis_graph(body,CONFIG['manifest'])}),flush=True)
    assert public('/bemine-v2/api/journal/build')[0]==401
    code,body=http('http://127.0.0.1:4174/api/rpc',{'jsonrpc':'2.0','id':1,'method':'eth_chainId','params':[]});assert code==200 and json.loads(body).get('result')=='0x38'
    code,body=public('/bemine-v2/data/bem-price.json');assert code==200
    quote=quote_valid(body);print(json.dumps({'publicQuote':quote}),flush=True)
    observe_index_cycles()

def main():
    digest=sha(json.dumps(CONFIG,sort_keys=True).encode())
    if PHASE=='rollback':
        state=json.loads(regular(backup/'prepared.json'));assert state['configDigest']==digest
        restore_hotfix(state);print(json.dumps({'rolledBack':True,'databasesRestored':False,'databasesPreserved':True,'productCurrentPreserved':True}));return
    preserved_surface()
    for name in ['pinkuang-deploy-v2.service','pinkuang-index-v2.service']:
        current=service(name);assert current['ActiveState']=='active' and current['User']=='pinkuang-v2'
    for name,path in targets.items():assert sha(regular(path))==CONFIG[{'unit':'deployUnitSha256','index-unit':'indexUnitSha256','snippet':'productSnippetSha256'}[name]]
    ids=current_database_ids(require_idle=True);no_links(price_path);quote_valid(price_path.read_bytes())
    runtime_manifest=verify_files(runtime,'release-manifest.json',CONFIG['runtimeManifestSha256'],CONFIG['runtimeSourceHead'])
    product_manifest=verify_files(product,'product-release-manifest.json',CONFIG['productManifestSha256'],CONFIG['productSourceHead'])
    assert runtime_manifest['kind']=='integrated-v2' and runtime_manifest['transactionCount']==16 and product_manifest['basePath']=='/bemine-v2'
