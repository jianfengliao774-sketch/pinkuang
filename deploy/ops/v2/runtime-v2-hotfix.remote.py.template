    assert value.get('status')=='ok' and value.get('chainId')==56 and value.get('quoteCurrency')=='USDT'
    assert value.get('tokenAddress')=='0x5ce033b2bfca3af30b3e8c8457deaf776a8b695a'
    assert value.get('poolAddress')=='0x28b12792f9d81bd529bc5572434e861c9edbbbc2'
    assert value.get('conversionPoolAddress')=='0x172fcd41e0913e95784454622d1c3724f546f849'
    price=value.get('priceUsdt');assert type(price) in [int,float] and math.isfinite(price) and price>0
    for key in ['updatedAt','blockTimestamp']:
