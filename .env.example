# Read-only archive RPC for T0.2. Never put a wallet key in this file.
BSC_RPC_URL=https://bsc-mainnet.public.blastapi.io
# Set once, record in docs/M0-report.md, and reuse for all protocol probes.
FORK_BLOCK=123728000
# Windows only: adjust to the local Git for Windows installation.
# OPENZEPPELIN_BASH_PATH=D:/Program Files/Git/bin/bash.exe
# Deployment simulation uses public addresses only; see docs/deployment.md.
# DEPLOYER=<public deployment account address>
# OWNER_MULTISIG=<verified 2-of-3 multisig address>
# OPERATOR=<separate daily operator address>
# TREASURY=<verified multisig address>
